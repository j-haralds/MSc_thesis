    "def get_data(file_name):\n",
    "    df = pd.read_csv(\n",
    "        f\"../Multi_data/other/{file_name}.txt\",\n",
    "        sep=r\"\\s+\",\n",
    "        comment=\"%\",\n",
    "        header=None\n",
    "    )\n",
    "\n",
    "    df.columns = ['u_par','C','t','E_cell (V)','I_cell (A)','Rx_cell (N)','u_cell (m)','E_ocv_cell (V)','soc_cell (1)']\n",
    "    df.columns = ['u_par', 'C', 't', 'V', 'I', 'F', 'u', 'Ue', 'soc']\n",
    "\n",
    "    # Sort by time within each batch\n",
    "    return df\n",
    "\n",
    "df_low = get_data('GP_run')\n",
    "\n",
    "\n",
    "\n",
    "soc = np.linspace(0,1,1000)\n",
    "plt.figure(figsize=(4,3.5))\n",
    "\n",
    "plt.plot(soc, U_eq_func(soc), lw = 2, label='SR')\n",
    "plt.plot(df_low['soc'], df_low['Ue'], lw = 2, ls = '--', label='Data', color = 'black', alpha = 0.5)\n",
    "plt.xlabel('State of Charge')\n",
    "plt.ylabel(r'$U_{eq}$ [V]')\n",
    "plt.legend()\n",
    "plt.savefig(f'SR_figs/SP/model_Ue_{RUN_ID}_fit.pdf', bbox_inches='tight')"
